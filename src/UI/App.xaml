<Application x:Class="Pome.UI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Default">
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#1473E6"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2584F7"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0D61C5"/>
        <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1473E6"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2584F7"/>
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0D61C5"/>
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White"/>
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#69B0FF"/>
      </ResourceDictionary>
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#1469D2"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0F5EBF"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0B50A7"/>
        <SolidColorBrush x:Key="AccentButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White"/>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1469D2"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0F5EBF"/>
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0B50A7"/>
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White"/>
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#005AB8"/>
      </ResourceDictionary>
      <ResourceDictionary x:Key="HighContrast">
        <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
        <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
  </ResourceDictionary></Application.Resources>
</Application>
